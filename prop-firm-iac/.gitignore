# Local .terraform directories
    **/.terraform/*

    # .tfstate files
    *.tfstate
    *.tfstate.*

    # Crash log files
    crash.log
    crash.*.log

    # Exclude all .tfvars files, which are likely to contain sensitive data,
    # except for example files.
    *.tfvars
    !*.tfvars.example

    # Ignore override files as they are usually used for local testing or sensitive data.
    override.tf
    override.tf.json
    *_override.tf
    *_override.tf.json

    # Include provider configuration files that may contain sensitive data.
    .terraformrc
    terraform.rc
